FROM ubuntu:26.04@sha256:7b202b0e2e0028c6250f5fcf41d04df492d145a1654c6995a6553f0c1f6f1960

ARG DEBIAN_FRONTEND=noninteractive

# The base image ships libc 2.43-2ubuntu2. Use only the matching release
# pocket so apt cannot silently mix in resolute-updates/security revisions.
RUN sed -i 's/^Suites: resolute resolute-updates resolute-backports$/Suites: resolute/' \
        /etc/apt/sources.list.d/ubuntu.sources \
    && sed -i '/^## Ubuntu security updates/,$d' \
        /etc/apt/sources.list.d/ubuntu.sources

# Compiler, linker, libc headers, and Make are fixed to the verified base ABI.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        binutils=2.46-3ubuntu2 \
        gcc=4:15.2.0-5ubuntu1 \
        gcc-15=15.2.0-16ubuntu1 \
        libc6-dev=2.43-2ubuntu2 \
        make=4.4.1-3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY Makefile late_checkout.c tcp_listener.c record_constants.sh verify_binary.sh ./
RUN make -j1 clean all \
    && ./verify_binary.sh ./late_checkout
